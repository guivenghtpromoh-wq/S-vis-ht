# SÈVIS-HT Backend Environment Variables
# Copy this file to .env and fill in with actual values

# Node Environment
NODE_ENV=production
PORT=4000

# Database Configuration
DATABASE_URL=postgresql://user:password@neon-host/database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Application URL
APP_URL=https://sevis-ht.example.com

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,https://sevis-ht.example.com

# Email Configuration (Resend API)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@sevis-ht.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Configuration (MonCash)
PAYMENT_WEBHOOK_SECRET=your-moncash-webhook-secret
MONCASH_API_KEY=your-moncash-api-key
MONCASH_API_SECRET=your-moncash-api-secret

# Security
BCRYPT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
OTP_EXPIRY_MINUTES=10

# Logging
LOG_LEVEL=info

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Admin Configuration
SUPER_ADMIN_EMAIL=admin@sevis-ht.com
